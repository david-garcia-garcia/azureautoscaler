# ============================================================================
# Azure Autoscaler Configuration Template
# ============================================================================
# This is a template configuration file. Copy this file to config.yml and
# replace all placeholder values with your actual Azure resource identifiers.
#
# IMPORTANT: Never commit config.yml to version control - it contains
# sensitive information about your Azure resources.
# ============================================================================

# Set WhatIf to true if you want to avoid actually scaling the resources.
DefaultResourceWhatIf: true
DefaultResourceEnabled: true
DefaultResourceFrequency: 10m
ResourceDiscoveryFrequency: 30m # How often to discover new resources
# Uses .Net 8 logging configuration
# see https://learn.microsoft.com/en-us/dotnet/core/extensions/console-log-formatter#set-formatter-with-configuration
Logging:
  LogLevel:
    Default: "Information"
    Microsoft.Hosting.Lifetime: "Information"
  Console:
    FormatterName: "simple"
    FormatterOptions:
      SingleLine: true
      TimestampFormat: "HH:HH:mm:ss"
Resources:
  ############################
  # AKS Node Pool example
  ############################
  - Resources: 
      aks_example_nodepools:
        ResourceId: "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example-aks/providers/Microsoft.ContainerService/managedClusters/aks-example-cluster/agentPools/{.*}"
    Frequency: 5m
    WhatIf: false
    ScalingConfigurations:
      baseline:
        Metrics:
          node_cpu_usage_percentage:
            Name: Percentage CPU
            Window: 00:10
            ResourceId: "${virtualMachineScaleSetId}"
            # This is not working for windows nodes, so we need to pick up directly the VMSS
            #Name: node_cpu_usage_percentage
            #SplitName: nodepool
            #SplitValue: ${nodePoolName}
            #ResourceId: "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroupName}/providers/Microsoft.ContainerService/managedClusters/${clusterName}"
          node_memory_available_percentage:
            Name: Available Memory Percentage
            Window: 00:10
            ResourceId: "${virtualMachineScaleSetId}"
          node_memory_available_bytes:
            Name: Available Memory Bytes
            Window: 00:10
            ResourceId: "${virtualMachineScaleSetId}"
          node_count:
            Name: VmAvailabilityMetric
            Window: 00:10
            ResourceId: "${virtualMachineScaleSetId}"
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          autoadjust_cpu:
            ScalingStrategy: Autoadjust
            Dimension: MinNodeCount
            DimensionValueMax: "5"
            DimensionValueMin: "1"
            ScaleUpCondition: "(data) => data.Metrics[\"node_cpu_usage_percentage\"].Values.Select(i => i.Average).Take(3).Average() > 85"
            ScaleDownCondition: "(data) => data.Metrics[\"node_cpu_usage_percentage\"].Values.Select(i => i.Average).Take(10).Average() < 60"
            ScaleUpTarget: "(data) => data.NextDimensionValue(1)"
            ScaleDownTarget: "(data) => data.PreviousDimensionValue(1)"
            ScaleUpCooldownSeconds: 240
            ScaleDownCooldownSeconds: 1200
          autoadjust_memory:
            ScalingStrategy: Autoadjust
            Dimension: MinNodeCount
            DimensionValueMax: "5"
            DimensionValueMin: "1"
            ScaleUpCondition: "(data) => data.Metrics[\"node_memory_available_percentage\"].Values.Select(i => i.Average).Take(1).Average() < 25"
            ScaleDownCondition: "(data) => data.Metrics[\"node_memory_available_percentage\"].Values.Select(i => i.Average).Take(1).Average() > 40"
            ScaleUpTarget: "(data) => data.NextDimensionValue(1)"
            ScaleDownTarget: "(data) => data.PreviousDimensionValue(1)"
            ScaleUpCooldownSeconds: 240
            ScaleDownCooldownSeconds: 1200
  ############################
  # SQL Elastic Pool Example
  ############################
  - Resources:
      example_sql_dev_pools:
        ResourceId: "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example-dev/providers/Microsoft.Sql/servers/sqlexample-dev/elasticPools/{.*}"
      example_sql_prod_pools:
        ResourceId: "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/rg-example-prod/providers/Microsoft.Sql/servers/sqlexample-prod/elasticPools/{.*}"
    Frequency: 3m
    WhatIf: false
    ScalingConfigurations:
      Baseline:
        ScaleDownLockWindowMinutes: 50
        ScaleUpAllowWindowMinutes: 58
        Metrics:
          dtu_consumption_percent:
            Name: dtu_consumption_percent
            Window: 00:10
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          autoadjust:
            ScalingStrategy: Autoadjust
            Dimension: Dtu
            ScaleUpCondition: "(data) => data.Metrics[\"dtu_consumption_percent\"].Values.Select(i => i.Average).Take(3).Average() > 85" # Average DTU > 85% for 3 minutes
            ScaleDownCondition: "(data) => data.Metrics[\"dtu_consumption_percent\"].Values.Select(i => i.Average).Take(6).Average() < 60" # Average DTU < 60% for 6 minutes
            ScaleUpTarget: "(data) => data.NextDimensionValue(1)" # You could actually specificy DTU number manually, and system will find closes valid tier
            ScaleDownTarget: "(data) => data.PreviousDimensionValue(1)" # You could actually specificy DTU number manually, and system will find closes valid tier
            ScaleUpCooldownSeconds: 180
            ScaleDownCoolDownSeconds: 3600
            DimensionValueMax: "200"
            DimensionValueMin: "50"
      MaxDataBytes:
        Metrics:
          storage_used:
            Name: storage_used
            Window: 00:05
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          fixed:
            ScalingStrategy: Fixed
            Dimension: MaxDataBytes
            # Fix target of extra 50GB or 20% additional of current storage, whatever is greater.
            ScaleTarget: "(data) => (Math.Max(data.Metrics[\"storage_used\"].Values.First().Average.Value + (50.1*1024*1024*1024), data.Metrics[\"storage_used\"].Values.First().Average.Value * 1.2)).ToString()"
  ##########################################################
  # Azure SQL stand-alone database example
  ##########################################################
  - Resources:
      example_sql_database:
        ResourceId: "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example-databases/providers/Microsoft.Sql/servers/sqlexample-server/databases/*"
    Frequency: 5m
    WhatIf: false
    Enabled: true
    ScalingConfigurations:
      Baseline:
        ScaleDownLockWindowMinutes: 50
        ScaleUpAllowWindowMinutes: 50
        Metrics:
          dtu_consumption_percent:
            Name: dtu_consumption_percent
            Window: 00:05
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          autoadjust:
            ScalingStrategy: Autoadjust
            Dimension: Dtu
            ScaleUpCondition: "(data) => data.Metrics[\"dtu_consumption_percent\"].Values.Select(i => i.Average).Take(3).Average() > 85" # Average DTU > 85% for 3 minutes
            ScaleDownCondition: "(data) => data.Metrics[\"dtu_consumption_percent\"].Values.Select(i => i.Average).Take(5).Average() < 60" # Average DTU < 60% for 5 minutes
            ScaleUpTarget: "(data) => data.NextDimensionValue(1)" # You could actually specificy DTU number manually, and system will find closes valid tier
            ScaleDownTarget: "(data) => data.PreviousDimensionValue(1)" # You could actually specificy DTU number manually, and system will find closes valid tier
            ScaleUpCooldownSeconds: 180
            ScaleDownCoolDownSeconds: 3600
            DimensionValueMax: "200"
            DimensionValueMin: "10"
  ###########################################
  # Azure MySQL Flexible Server DEV
  ###########################################
  - Resources:
      example_mysql_dev:
        ResourceId: "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example-dev-mysql/providers/Microsoft.DBforMySQL/flexibleServers/mysqlexample-dev"
    Frequency: 5m
    WhatIf: false
    ScalingConfigurations:
      Baseline:
        ScaleDownLockWindowMinutes: 50
        ScaleUpAllowWindowMinutes: 50
        Metrics:
          cpu_percent:
            Name: cpu_percent
            Window: 00:10
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          autoadjust:
            ScalingStrategy: Autoadjust
            Dimension: Sku
            ScaleUpCondition: "(data) => data.Metrics[\"cpu_percent\"].Values.Select(i => i.Average).Take(3).Average() > 85" # Average CPU > 85% for 3 minutes
            ScaleDownCondition: "(data) => data.Metrics[\"cpu_percent\"].Values.Select(i => i.Average).Take(5).Average() < 60" # Average CPU < 60% for 5 minutes
            ScaleUpTarget: "(data) => data.NextDimensionValue(1)" # You could actually specificy SKU manually, and system will find closes valid tier
            ScaleDownTarget: "(data) => data.PreviousDimensionValue(1)" # You could actually specificy SKU manually, and system will find closes valid tier
            ScaleUpCooldownSeconds: 180
            ScaleDownCoolDownSeconds: 3600
            DimensionValueMax: "Standard_B4ms"
            DimensionValueMin: "Standard_B1ms"
      ForecastDaily:
        Metrics:
          custom_sku_corecount_forecast:
            Name: custom_sku_corecount_forecast
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: "Romance Standard Time"
        ScalingRules:
          fixed:
            ScalingStrategy: Fixed
            Dimension: Sku
            ScaleTarget: "(data) => (np(data.Metrics[\"custom_sku_corecount_forecast\"].Values.FirstOrDefault()).CustomString).ToString()"
  ###################################
  # Azure MySQL Flexible Server PROD
  ###################################
  - Resources:
      example_mysql_prod:
        ResourceId: "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/rg-example-prod-mysql/providers/Microsoft.DBforMySQL/flexibleServers/mysqlexample-prod"
    Frequency: 10m
    WhatIf: false
    ScalingConfigurations:
      Baseline:
        ScaleDownLockWindowMinutes: 50
        ScaleUpAllowWindowMinutes: 50
        Metrics:
          cpu_percent:
            Name: cpu_percent
            Window: 00:10
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          autoadjust:
            ScalingStrategy: Autoadjust
            Dimension: Sku
            ScaleUpCondition: "(data) => data.Metrics[\"cpu_percent\"].Values.Select(i => i.Average).Take(3).Average() > 85"
            ScaleDownCondition: "(data) => data.Metrics[\"cpu_percent\"].Values.Select(i => i.Average).Take(5).Average() < 60"
            ScaleUpTarget: "(data) => data.NextDimensionValue(1)"
            ScaleDownTarget: "(data) => data.PreviousDimensionValue(1)"
            ScaleUpCooldownSeconds: 600
            ScaleDownCoolDownSeconds: 3600
            DimensionValueMax: "Standard_B4ms"
            DimensionValueMin: "Standard_B1ms"
      ForecastDaily:
        Metrics:
          custom_sku_corecount_forecast:
            Name: custom_sku_corecount_forecast
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: "Romance Standard Time"
        ScalingRules:
          fixed:
            ScalingStrategy: Fixed
            Dimension: Sku
            ScaleTarget: "(data) => (data.Metrics[\"custom_sku_corecount_forecast\"].Values.FirstOrDefault().CustomString).ToString()"
      MinSku:
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: "Romance Standard Time"
        ScalingRules:
          fixed:
            ScalingStrategy: Fixed
            Dimension: Sku
            ScaleTarget: "(data) => (\"Standard_B1ms\")"
      Iops:
        Metrics:
          storage_io_count:
            Name: storage_io_count
            Window: "00:05"
            Granularity: "00:01"
            Aggregations: ["Total"]
          io_consumption_percent:
            Name: io_consumption_percent
            Window: 00:10
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: "Romance Standard Time"
        ScalingRules:
          autoadjust:
            ScalingStrategy: Autoadjust
            Dimension: Iops
            ScaleUpCondition: "(data) => data.Metrics[\"io_consumption_percent\"].Values.Select(i => i.Average).Take(5).Average() > 85"
            ScaleDownCondition: "(data) => data.Metrics[\"io_consumption_percent\"].Values.Select(i => i.Average).Take(5).Average() < 80"
            ScaleUpTarget: "(data) => ((data.Metrics[\"storage_io_count\"].Values.Select(i => i.Total).Take(5).Average() / 60.1) * 1.2).ToString()"
            ScaleDownTarget: "(data) => ((data.Metrics[\"storage_io_count\"].Values.Select(i => i.Total).Take(5).Average() / 60.1) * 0.8).ToString()"
            ScaleUpCooldownSeconds: 180
            ScaleDownCoolDownSeconds: 3600
            DimensionValueMax: "1500"
            DimensionValueMin: "400"
  ###################################
  # DEV file storage
  ###################################
  - Resources:
      example_storage_dev:
        ResourceId: "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example-dev/providers/Microsoft.Storage/storageAccounts/stexampleappsharedfiles/fileServices/default/shares/{.*}"
    Frequency: 30m
    Enabled: true
    WhatIf: false
    ScalingConfigurations:
      Baseline:
        Metrics:
          FileCapacity:
            Name: FileCapacity
            ResourceId: "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroupName}/providers/Microsoft.Storage/storageAccounts/${storageAccountName}/fileServices/default"
            Window: 02:00:00
            TimeGrain: 01:00:00 
            SplitName: "FileShare"
            SplitValue: "${fileShareName}"
            Aggregations: ["Average"]
            Transform: "(value) => value.SetAverage(value.Average / (1000 * 1000 * 1000))" # Convert to Gb
          FileThroughput:
            Name: FileShareMaxUsedBandwidthMiBps
            ResourceId: "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroupName}/providers/Microsoft.Storage/storageAccounts/${storageAccountName}/fileServices/default"
            Window: 00:45:00
            TimeGrain: 00:15:00 
            SplitName: "FileShare"
            SplitValue: "${fileShareName}"
            Aggregations: ["Average"]
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          fixedCapacity:
            ScalingStrategy: Fixed
            Dimension: ProvisionedStorage
            # Add 125GB buffer above current usage for large database shares
            ScaleTarget: "(data) => (data.Metrics[\"FileCapacity\"].Values.First().Average + 125).ToString()"
          fixedThroughtput:
            ScalingStrategy: Fixed
            Dimension: Throughput
            ScaleTarget: "(data) => (data.Metrics[\"FileThroughput\"].Values.First().Average + 10).ToString()"
  ###################################
  # PROD file storage
  ###################################
  - Resources:
      example_storage_prod:
        ResourceId: "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/rg-example-prod-storage/providers/Microsoft.Storage/storageAccounts/stexampleprodappsharedfileszrs/fileServices/default/shares/{.*}"
    Frequency: 30m
    Enabled: true
    WhatIf: false
    ScalingConfigurations:
      Baseline:
        Metrics:
          FileCapacity:
            Name: FileCapacity
            ResourceId: "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroupName}/providers/Microsoft.Storage/storageAccounts/${storageAccountName}/fileServices/default"
            Window: 02:00:00
            TimeGrain: 01:00:00 
            SplitName: "FileShare"
            SplitValue: "${fileShareName}"
            Aggregations: ["Average"]
            Transform: "(value) => value.SetAverage(value.Average / (1000 * 1000 * 1000))" # Convert to Gb
          FileThroughput:
            Name: FileShareMaxUsedBandwidthMiBps
            ResourceId: "/subscriptions/${subscriptionId}/resourceGroups/${resourceGroupName}/providers/Microsoft.Storage/storageAccounts/${storageAccountName}/fileServices/default"
            Window: 00:45:00
            TimeGrain: 00:15:00 
            SplitName: "FileShare"
            SplitValue: "${fileShareName}"
            Aggregations: ["Average"]
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          fixedCapacity:
            ScalingStrategy: Fixed
            Dimension: ProvisionedStorage
            # Add 125GB buffer above current usage for large database shares
            ScaleTarget: "(data) => (data.Metrics[\"FileCapacity\"].Values.First().Average + 125).ToString()"
          fixedThroughtput:
            ScalingStrategy: Fixed
            Dimension: Throughput
            ScaleTarget: "(data) => (data.Metrics[\"FileThroughput\"].Values.First().Average + 10).ToString()"
  ####################################################################
  # Azure DevOps Parallel Jobs (MS-hosted and self-hosted)
  ####################################################################
  # This uses the undocumented Azure DevOps Commerce API to programmatically
  # change the number of purchased parallel jobs based on pipeline queue metrics.
  #
  # Resource ID format: azuredevops://{organization}
  # The organization name is the one from your Azure DevOps URL (dev.azure.com/yourorg).
  # The organization ID (GUID) is resolved automatically via API.
  #
  # Settings (in the resource configuration):
  #   Pat: Required. PAT with Agent Pools (read) and billing permissions.
  #        Can be the actual PAT value, or "env://VAR_NAME" to read from an environment variable.
  #
  # Available custom metrics (aggregated across all pools of each type):
  #   custom_azdo_queued_hosted       - Total queued jobs across all MS-hosted pools
  #   custom_azdo_queued_self_hosted  - Total queued jobs across all self-hosted pools
  #   custom_azdo_running_hosted      - Total running jobs across all MS-hosted pools
  #   custom_azdo_running_self_hosted - Total running jobs across all self-hosted pools
  #   custom_azdo_available_hosted         - Available hosted capacity (parallel jobs limit - running jobs)
  #   custom_azdo_available_self_hosted    - Available self-hosted capacity (parallel jobs limit - running jobs)
  ####################################################################
  - Resources:
      azdo_parallel_jobs:
        # Replace 'myorg' with your organization name (from dev.azure.com/myorg)
        ResourceId: "azuredevops://myorg"
        Settings:
          # Option 1: Direct PAT value (useful for testing, but be careful with secrets in config files!)
          # Pat: "your-personal-access-token-here"
          # Option 2: Reference an environment variable (recommended for production)
          Pat: "env://AZDO_PAT"
    Frequency: 1m
    Enabled: true
    WhatIf: true  # Set to false to actually change parallel jobs (this affects billing!)
    ScalingConfigurations:
      HostedJobs:
        Metrics:
          queued_hosted:
            Name: custom_azdo_queued_hosted  # Aggregated across all MS-hosted pools
        TimeWindow:
          Days: All
          Months: All
          StartTime: "00:00"
          EndTime: "23:59"
          TimeZone: UTC
        ScalingRules:
          # Scale up MS-hosted parallel jobs when pipelines are queued
          scale_hosted:
            ScalingStrategy: Autoadjust
            Dimension: HostedParallelJobs
            DimensionValueMin: "0"   # Scale to zero when idle (save costs!)
            DimensionValueMax: "5"   # Cap at 5 parallel jobs (~$200/month max)
            # Scale up immediately when there are queued jobs
            ScaleUpCondition: "(data) => data.Metrics[\"queued_hosted\"].Values.First().Average > 0"
            # Scale down when no jobs are queued for the evaluation window
            ScaleDownCondition: "(data) => data.Metrics[\"queued_hosted\"].Values.First().Average == 0"
            ScaleUpTarget: "(data) => Math.Min(5, (int)data.Metrics[\"queued_hosted\"].Values.First().Average + 1).ToString()"
            ScaleDownTarget: "(data) => \"0\""
            ScaleUpCooldownSeconds: 60      # Quick scale up for responsiveness
            ScaleDownCooldownSeconds: 1800  # 30 min cooldown before scale down (avoid rapid oscillation)
      # SelfHostedJobs:
      #   Metrics:
      #     queued_self_hosted:
      #       Name: custom_azdo_queued_self_hosted  # Aggregated across all self-hosted pools
      #   TimeWindow:
      #     Days: All
      #     Months: All
      #     StartTime: "00:00"
      #     EndTime: "23:59"
      #     TimeZone: UTC
      #   ScalingRules:
      #     scale_private:
      #       ScalingStrategy: Autoadjust
      #       Dimension: PrivateParallelJobs
      #       DimensionValueMin: "0"
      #       DimensionValueMax: "10"
      #       ScaleUpCondition: "(data) => data.Metrics[\"queued_self_hosted\"].Values.First().Average > 0"
      #       ScaleDownCondition: "(data) => data.Metrics[\"queued_self_hosted\"].Values.First().Average == 0"
      #       ScaleUpTarget: "(data) => data.NextDimensionValue(1)"
      #       ScaleDownTarget: "(data) => \"0\""
      #       ScaleUpCooldownSeconds: 60
      #       ScaleDownCooldownSeconds: 1800
